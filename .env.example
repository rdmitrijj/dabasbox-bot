# Telegram bot token from @BotFather
BOT_TOKEN=123456789:replace-with-your-token
# Chat that receives order notifications (user id, or group id like -1001234567890).
# The bot must be a member of the group and allowed to post.
ADMIN_CHAT_ID=-1001234567890

# FSM storage: memory (default, state is lost on restart) or redis
FSM_STORAGE=memory
REDIS_URL=redis://localhost:6379/0
REDIS_STATE_TTL=604800

# Every confirmed order is also appended here (JSON lines)
ORDERS_LOG_PATH=data/orders.jsonl
LOG_LEVEL=INFO
